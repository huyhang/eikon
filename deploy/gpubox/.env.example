# Copy to .env and adjust. Eikon must be configured with the same token.
# Generate one with: openssl rand -hex 32
TAGGER_TOKEN=

# Any WD v3 model repo; wd-vit-tagger-v3 is smaller/faster, eva02-large is the most accurate.
TAGGER_MODEL_REPO=SmilingWolf/wd-eva02-large-tagger-v3

# Lowest confidence returned to Eikon (Eikon's own thresholds decide what is shown).
TAGGER_MIN_CONFIDENCE=0.2

# auto | cuda | cpu   (cuda refuses to start without a working GPU)
TAGGER_DEVICE=auto

# Uploads larger than this are rejected with 413 (Eikon sends ~2048px WebP previews).
TAGGER_MAX_BODY_BYTES=52428800
