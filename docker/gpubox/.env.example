# Copy to .env and adjust. Eikon must be configured with the same token.
# Generate one with: openssl rand -hex 32
TAGGER_TOKEN=

# Any WD v3 model repo; wd-vit-tagger-v3 is smaller/faster, eva02-large is the most accurate.
TAGGER_MODEL_REPO=SmilingWolf/wd-eva02-large-tagger-v3

# CLIP model for "similar images" and describe-in-words search (Xenova ONNX layout).
# clip-vit-large-patch14 is the most accurate; clip-vit-base-patch16 is lighter. "off" disables embeddings.
# Changing it makes Eikon re-embed every image in the background.
TAGGER_EMBED_REPO=Xenova/clip-vit-large-patch14

# fp32 | fp16 — fp16 roughly halves CLIP's VRAM with no visible difference in search results.
TAGGER_EMBED_PRECISION=fp32

# Lowest confidence returned to Eikon (Eikon's own thresholds decide what is shown).
TAGGER_MIN_CONFIDENCE=0.2

# auto | cuda | cpu   (cuda refuses to start without a working GPU)
TAGGER_DEVICE=auto

# Up to this many concurrent images share one GPU call; the first waits this long for company.
TAGGER_MAX_BATCH=16
TAGGER_BATCH_WAIT_MS=5

# Uploads larger than this are rejected with 413 (Eikon sends ~2048px WebP previews).
TAGGER_MAX_BODY_BYTES=52428800
