# Copy to .env (same folder as compose.yaml) and fill in.

# Your illustration share: must contain Illustrators/ and Collections/. Mounted read-only.
LIBRARY_PATH=/volume1/Illustrations

# Eikon's database and thumbnails (a few hundred KB per image).
DATA_PATH=/volume1/docker/eikon-data

# Your DSM user/group ids — run `id` over SSH (e.g. uid=1026 gid=100).
PUID=1026
PGID=100

# Passcode for the lock screen. Digits only shows a keypad. Leave empty to disable.
EIKON_PASSCODE=

# gpubox's MagicDNS name (Tailscale admin console → DNS shows your tailnet name, e.g. tail1234.ts.net).
EIKON_TAGGER_URL=http://gpubox.tailXXXX.ts.net:7860
# Must match TAGGER_TOKEN on gpubox (docker/gpubox/.env).
EIKON_TAGGER_TOKEN=

# Optional tuning
# Loopback port on the NAS; the `tailscale serve` command must point at the same port (docs/SETUP.md 5.2).
# EIKON_HOST_PORT=8080
# EIKON_SCAN_INTERVAL_MINUTES=5
# EIKON_PROCESS_CONCURRENCY=2
# EIKON_TAG_CONCURRENCY=2
TZ=America/Los_Angeles
