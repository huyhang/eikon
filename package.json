{
  "name": "eikon",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "fake-tagger",
    "tools"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx tools/src/dev.ts",
    "sample-library": "tsx tools/src/makeSampleLibrary.ts",
    "build": "npm run build -w web && npm run build -w server",
    "start": "node server/dist/main.mjs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:prod": "npm run build && tsx tools/src/dev.ts --prod"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
